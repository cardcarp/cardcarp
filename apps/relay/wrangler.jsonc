{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "cardcarp-relay",
    "main": "src/index.js",
    "compatibility_date": "2025-01-01",

    "durable_objects": {
        "bindings": [
            { "name": "Room", "class_name": "Room" }
        ]
    },

    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["Room"] }
    ],

    // Per-IP limits, checked in the Worker before a Durable Object is created.
    "ratelimits": [
        {
            "name": "ROOM_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 60, "period": 60 }
        },
        {
            "name": "TICKET_LIMITER",
            "namespace_id": "1002",
            "simple": { "limit": 120, "period": 60 }
        }
    ],

    "observability": {
        "enabled": true
    }
}
