{
    "$schema": "node_modules/wrangler/config-schema.json",

    "name": "cardcarp",
    "compatibility_date": "2024-04-01",

    "assets": {
        "directory": "./.vitepress/dist",
        "not_found_handling": "404-page"
    },

    "routes": [
        { "pattern": "cardcarp.com", "custom_domain": true }
    ]
}
